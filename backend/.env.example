# Copy to .env and fill in before running Django.
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DEBUG=True
SECRET_KEY=replace-me-generate-with-secrets.token_urlsafe
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgis://mini_istanbul_user:mini_istanbul_dev_pass@localhost:5432/mini_istanbul_dev

# Redis (Faz 2'den itibaren; Faz 1'de kullanılmıyor)
REDIS_URL=redis://localhost:6379/0

# GeoDjango Windows only — PostgreSQL/PostGIS kurulumunun GDAL & GEOS DLL yolları
# (Linux/macOS'ta boş bırakılabilir; sistem PATH'inden çözülür)
GDAL_LIBRARY_PATH=C:/Program Files/PostgreSQL/15/bin/libgdal-35.dll
GEOS_LIBRARY_PATH=C:/Program Files/PostgreSQL/15/bin/libgeos_c.dll
